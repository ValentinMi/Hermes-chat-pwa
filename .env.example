# ----------------------------------------------------------------------------
# Configuration Hermes Chat PWA — copier en .env (dev) ou renseigner dans Coolify.
# ----------------------------------------------------------------------------

# Endpoint Hermes compatible OpenAI (le gateway Hermes Agent expose /v1 sur 8642).
# Exemples :
#   http://hermes:8642/v1                (service Docker voisin sur le même réseau)
#   http://host.docker.internal:8642/v1  (Hermes sur l'hôte)
#   https://openrouter.ai/api/v1         (via OpenRouter)
HERMES_BASE_URL=http://localhost:8642/v1

# Clé API du fournisseur Hermes. Reste côté serveur, jamais exposée au navigateur.
# Laisser vide si l'endpoint n'exige pas d'authentification.
HERMES_API_KEY=

# Modèle proposé par défaut dans l'interface.
HERMES_DEFAULT_MODEL=hermes-4

# Mot de passe d'accès à l'application (login simple mono-utilisateur).
APP_PASSWORD=change-me

# Secret de signature des cookies de session (chaîne aléatoire longue).
# Générer par ex. : openssl rand -hex 32
SESSION_SECRET=change-me-with-a-long-random-string

# Optionnel : port d'écoute du serveur (défaut 3000 en prod).
# PORT=3000

# Optionnel : durée de session en secondes (défaut 30 jours).
# SESSION_MAX_AGE=2592000
